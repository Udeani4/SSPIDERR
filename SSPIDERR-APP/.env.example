# Copy this file to .env and fill in the values. Never commit .env.

# --- Flask ---------------------------------------------------------------
# Long random string. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=
# 1 = debug mode with auto-reload (development only). Leave empty in production.
FLASK_DEBUG=
# Optional: development | production (default depends on FLASK_DEBUG)
APP_ENV=
# Optional: defaults to sqlite:///my_songs.db (stored in instance/). On Render this is the PostgreSQL URL.
DATABASE_URL=
# 1 when running behind an HTTPS proxy such as Render (set automatically by render.yaml)
TRUST_PROXY=

# --- Spotify (https://developer.spotify.com/dashboard) --------------------
SSPIDERR_SPOTIFY_CLIENT_ID=
SSPIDERR_SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI in the Spotify dashboard, e.g. http://127.0.0.1:5000/callback
SSPIDERR_SPOTIFY_REDIRECT_URI=
# Optional: public playlist shown as "Best hits" on the home page
SPOTIFY_BEST_HITS_PLAYLIST_ID=

# --- Last.fm (https://www.last.fm/api/account/create) ---------------------
LAST_FM_API_KEY=
LAST_FM_API_SECRET=
LAST_FM_REDIRECT_URI=

# --- NewsData.io (https://newsdata.io) ------------------------------------
NEWS_DATA_API_KEY=

# --- Optional: Google image search fallback for artist photos -------------
GOOGLE_CLOUD_API_KEY=
CX=

# --- Contact form (Gmail address + app password) -------------------------
EMAIL_KEY=
PASSWORD_KEY=
# Where contact-form messages are delivered (defaults to EMAIL_KEY)
CONTACT_RECIPIENT=

# --- Background jobs ------------------------------------------------------
# The home-page charts refresh once a day at 00:00 in this timezone, e.g. Africa/Lagos
SCHEDULER_TIMEZONE=UTC
HOME_REFRESH_MAX_AGE_HOURS=24
NEWS_REFRESH_HOURS=6
# Set to 0 to disable the scheduler (e.g. when running a second process)
SCHEDULER_ENABLED=1

# --- No longer used (safe to delete from your .env) -----------------------
# CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET,
# UNSPLASH_APP_ID, UNSPLASH_ACCESS_KEY, UNSPLASH_SECRET_KEY, UNSPLASH_REDIRECT_URI

# --- Uploads --------------------------------------------------------------
# Days to keep per-song recognition results after a job finishes (0 = keep forever).
# The uploaded audio files themselves are always deleted as soon as a job ends.
UPLOAD_RESULTS_RETENTION_DAYS=30
